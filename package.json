{
  "name": "college-review-system-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "render-build": "npm install --include=dev && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "prestart": "node scripts/verify-dist.mjs",
    "start": "serve dist -s -l tcp://0.0.0.0:${PORT:-4173}"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
